      "isListItem": true,
      "listId": "kix.de6lk9t0xx6h",
      "nestingLevel": null,
      "table": null,
      "text": "Designed and built the LangGraph engine behind Fix Now, an autonomous SAST/SCA remediation feature using AWS Bedrock, auditable tool-call persistence, concurrency controls, and live execution tracking",
      "protectedControls": []
    },
    {
      "paragraphId": "P00019",
      "path": "tabs.t.0.body.content[19]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
