      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.hlpun1pd23o",
      "nestingLevel": null,
      "table": null,
      "text": "Pioneered IAM Least-Privileged Access capabilities for eliminating unused permissions from high-risk users and roles",
      "protectedControls": []
    },
    {
