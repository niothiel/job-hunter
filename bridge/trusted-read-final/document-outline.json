      "isListItem": true,
      "listId": "kix.hlpun1pd23o",
      "nestingLevel": null,
      "table": null,
      "text": "Led development of the IAM product, processing 10M+ rows daily for multiple Fortune 500 customers",
      "protectedControls": []
    },
    {
      "paragraphId": "P00039",
      "path": "tabs.t.0.body.content[39]",
