      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.hlpun1pd23o",
      "nestingLevel": null,
      "table": null,
      "text": "Spearheaded an auto-scaling control plane that reduced developer and QA workload by 10+ hours per week and cut QA time by 10x",
      "protectedControls": []
    },
    {
      "paragraphId": "P00037",
      "path": "tabs.t.0.body.content[37]",
