      "startIndex": 1195,
      "endIndex": 1400,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.de6lk9t0xx6h",
      "nestingLevel": null,
      "table": null,
      "text": "Built the multi-ecosystem SCA remediation engine for npm, PyPI, Maven, Go, NuGet, and Ruby, including version parsing, minimum-safe-upgrade calculation, transitive solutions, and CycloneDX graph traversal",
      "protectedControls": []
    },
    {
      "paragraphId": "P00020",
      "path": "tabs.t.0.body.content[20]",
