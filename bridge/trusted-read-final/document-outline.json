      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.de6lk9t0xx6h",
      "nestingLevel": null,
      "table": null,
      "text": "Designed and led the migration of workflow automation from synchronous requests to asynchronous workers with rate limiting, automatic abuse shutdown and notification, and execution observability",
      "protectedControls": []
    },
    {
      "paragraphId": "P00022",
      "path": "tabs.t.0.body.content[22]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
