      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.orxwqi2q6dgg",
      "nestingLevel": null,
      "table": null,
      "text": "Fully fine-tuned a multi-step detection and identification model for automatically detecting MTG cards on a table from a webcam stream. (see a demo on the site)",
      "protectedControls": []
    },
    {
      "paragraphId": "P00032",
      "path": "tabs.t.0.body.content[32]",
