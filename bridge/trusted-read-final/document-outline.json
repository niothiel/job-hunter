      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.hlpun1pd23o",
      "nestingLevel": null,
      "table": null,
      "text": "Led development of Attack Path Analysis for visualizing network compromise routes",
      "protectedControls": []
    },
    {
