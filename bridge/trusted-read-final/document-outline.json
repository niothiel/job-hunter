      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.orxwqi2q6dgg",
      "nestingLevel": null,
      "table": null,
      "text": "Developed a significant React frontend for managing game state and interacting with player cards (autocomplete, health tracking, game events, dice rolls, etc).",
      "protectedControls": []
    },
    {
      "paragraphId": "P00033",
      "path": "tabs.t.0.body.content[33]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
