      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.orxwqi2q6dgg",
      "nestingLevel": null,
      "table": null,
      "text": "Big Piece: Learned computer vision from first principles (\"classical\" CV like SIFT), all the way through unsupervised transformer architectures like DINOv3.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00031",
      "path": "tabs.t.0.body.content[31]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
