      "startIndex": 1762,
      "endIndex": 1954,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.de6lk9t0xx6h",
      "nestingLevel": null,
      "table": null,
      "text": "Built SCA and remediation experiences across FastAPI, PostgreSQL, React, and TypeScript, including dependency graphs, vulnerability reachability, SBOM export, and CVSS/EPSS-based SLO tracking",
      "protectedControls": []
    },
    {
