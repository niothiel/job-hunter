      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.de6lk9t0xx6h",
      "nestingLevel": null,
      "table": null,
      "text": "Designed a transparent package-manager proxy and repository-scoped memory system that let sandboxed agents safely resolve dependencies and retain context between runs",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
