      "isListItem": true,
      "listId": "kix.de6lk9t0xx6h",
      "nestingLevel": null,
      "table": null,
      "text": "Built out a comprehensive standard for Python backends using modern tools (uv, ruff, black), rolling it out with minimal friction across 10+ members.",
