# Pushover notification credentials (optional)
# Copy this file to .devin/pipeline.env and fill in your values.
# If left empty, notifications are silently disabled — the pipeline still runs.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ─── LLM Observability (Arize Phoenix) — optional, ADR-0014 ────────────────
# Install Phoenix first:  pip install -r requirements-observability.txt
# Then start the server:  python -m phoenix serve
# Set PHOENIX_HOST to enable tracing. If unset or Phoenix is not installed,
# tracing is silently skipped — the pipeline runs normally.
# PHOENIX_HOST=http://localhost:6006
